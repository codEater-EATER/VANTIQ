# ============= CRITICAL: CHANGE ALL VALUES IN .env FILE =============
# Copy this file to .env and fill in your actual values
# NEVER commit .env file - it contains secrets!

# ============= BACKEND =============
BACKEND_PORT=3001
NODE_ENV=development

# ============= DATABASE (Required) =============
# Get from: https://supabase.com (PostgreSQL connection string)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/vantiq
REDIS_URL=redis://localhost:6379

# ============= SUPABASE =============
# Get from: https://app.supabase.com → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ... (starts with eyJ)
SUPABASE_SERVICE_KEY=eyJ... (starts with eyJ)

# ============= APIFY (Web Scraping - Required) =============
# Get from: https://apify.com → Settings → API Tokens
# Format: apify_api_xxxxxxxxxxxxxxx
APIFY_API_KEY=apify_api_xxxxx
APIFY_API_ENDPOINT=https://api.apify.com/v2

# ============= APOLLO.IO (B2B Leads - Required) =============
# Get from: https://app.apollo.io → Settings → Integrations → API Keys
APOLLO_API_KEY=xxxxx
APOLLO_API_ENDPOINT=https://api.apollo.io/v1

# ============= CLERK (Authentication - Required) =============
# Get from: https://dashboard.clerk.com → API Keys
# Secret key starts with sk_test_ or sk_live_
# Publishable key starts with pk_test_ or pk_live_
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx

# ============= SENDGRID (Email - Optional) =============
# Get from: https://app.sendgrid.com → Settings → API Keys
# Format: SG.xxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============= AI - Choose ONE =============
# Option 1: Local Ollama (Recommended for Development)
AI_PROVIDER=ollama
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Option 2: DashScope Cloud (Alternative)
# Get from: https://dashscope.aliyun.com → API Keys
# AI_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-xxxxx
# QWEN_MODEL=qwen-max
# QWEN_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1

# ============= JWT AUTHENTICATION =============
# Generate random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-random-string-32-chars-or-more
JWT_EXPIRY=7d

# ============= LOGGING =============
LOG_LEVEL=debug

# ============= FRONTEND =============
# These should match CLERK values
# In apps/web/.env.local (auto-generated by Clerk CLI)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
# CLERK_SECRET_KEY=sk_test_xxxxx
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/signin
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/signup
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ============= NOTES =============
# 1. Always keep .env file in .gitignore (do NOT commit)
# 2. For production, use environment variables provided by your hosting (Vercel, Railway, etc.)
# 3. Rotate API keys regularly (every 90 days)
# 4. Use different keys for development and production
# 5. Never share your .env file with anyone
# 6. Use a password manager to store these values
