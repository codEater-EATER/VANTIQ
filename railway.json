{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && cd apps/backend && npm run build"
  },
  "deploy": {
    "startCommand": "cd apps/backend && npm start",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 5
  }
}
